{
  "data_dir": "data",
  "database_name": "rag_book.db",
  "chunk_size": 1800,
  "chunk_overlap": 220,
  "sparse_top_k": 30,
  "dense_top_k": 30,
  "rerank_top_k": 12,
  "context_top_k": 6,
  "rrf_k": 60,
  "chroma_dir": "data/chroma",
  "chroma_collection": "rag_chunks",
  "embedding_model": "models/bge-small-zh-v1.5",
  "embedding_local_files_only": true,
  "reranker_model": "models/bge-reranker-base",
  "reranker_local_files_only": true,
  "web_search_enabled": false,
  "deepseek_web_search": true,
  "deepseek_web_max_tool_calls": 6,
  "deepseek_web_max_output_tokens": 1400,
  "web_search_url": "",
  "web_search_provider": "duckduckgo",
  "web_search_candidate_multiplier": 3,
  "web_search_per_domain_limit": 2,
  "web_search_max_workers": 4,
