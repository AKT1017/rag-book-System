  "child_chunk_size": 900,
  "agent_timeout_seconds": 45,
  "agent_max_react_steps": 3,
  "agent_local_confidence_threshold": 0.8,
  "agent_local_context_chars": 6000,
  "agent_web_context_chars": 4000,
  "agent_web_timeout_seconds": 30,
  "agent_planner_timeout_seconds": 1.5,
  "agent_fast_question_max_chars": 32,
  "agent_two_stage_full_sources": 3
